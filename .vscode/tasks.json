{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++23",
                "-g",
                "-Wall",
                "-Wl,--stack=536870912",
                "-I",
                "D:/ICPC",
                "${file}",
                "-o",
                "D:\\ICPC\\programmes_C_Cpp\\build\\a.exe",
                "-lwsock32"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|note):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true // 保留 C++ 作为默认构建任务
            },
            "detail": "调试器生成的任务。"
        },
        // --- 下面是新添加的 Rust 任务 ---
        {
            "label": "cargo build",
            "type": "cargo",
            "command": "build",
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build", // 这里去掉了 isDefault: true，避免与 C++ 冲突
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "cargo run",
            "type": "cargo",
            "command": "run",
            "problemMatcher": [
                "$rustc"
            ]
        }
    ]
}